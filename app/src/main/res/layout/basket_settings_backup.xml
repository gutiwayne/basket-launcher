<?xml version="1.0" encoding="utf-8"?>
<!-- Basket Launcher: Backup section, inserted into the settings screen by ui/BackupSection.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="12dp"
    android:background="@drawable/rounded_rect_shade_color"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="16dp">

    <TextView
        style="@style/TextLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:text="@string/basket_backup"
        android:textColor="?attr/primaryColor" />

    <TextView
        android:id="@+id/basketBackupExport"
        style="@style/TextSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:paddingVertical="8dp"
        android:text="@string/basket_backup_export"
        android:textColor="?attr/primaryColor" />

    <TextView
        android:id="@+id/basketBackupImport"
        style="@style/TextSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:paddingVertical="8dp"
        android:text="@string/basket_backup_import"
        android:textColor="?attr/primaryColor" />

    <TextView
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:alpha="0.6"
        android:text="@string/basket_backup_note"
        android:textColor="?attr/primaryColor" />
</LinearLayout>
